{
  "name": "spell",
  "version": "0.1.0",
  "private": true,
  "description": "Spell - low-poly first-person multiplayer survival prototype for the browser (WebGL + authoritative WebSocket server)",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node test/harness.js",
    "verify:browser": "node test/browser.js",
    "test:client": "node test/client-net.js",
    "test:all": "node test/harness.js && node test/client-net.js && node test/ui-static.js",
    "test:ui": "node test/ui-static.js"
  },
  "keywords": [
    "game",
    "webgl",
    "three.js",
    "multiplayer",
    "survival",
    "prototype"
  ],
  "license": "MIT",
  "dependencies": {
    "three": "0.169.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "puppeteer": "^23.0.0"
  }
}
