# Supabase (public/anon key is safe to expose; RLS enforces all access)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: mark the environment as a demo. Real data is always used when the
# two variables above are set. Never put a service_role key in the browser.
VITE_DEMO_LABEL=NEXA Demo
